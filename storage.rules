rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Permite que usuários autenticados façam upload em sua própria pasta
    match /attachments/{type}/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024  // max 10MB
                   && (
                        request.resource.contentType.matches('image/.*') ||
                        request.resource.contentType == 'application/pdf' ||
                        request.resource.contentType == 'application/msword' ||
                        request.resource.contentType.matches('application/vnd.openxmlformats.*')
                      );
    }
  }
}
